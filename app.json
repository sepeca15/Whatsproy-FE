{
  "expo": {
    "name": "Whatsproy",
    "slug": "Whatsproy",
    "appVersion": "1.6.7",
    "runtimeVersion": "1.6.7",
    "newArchEnabled": true,
    "version": "1.6.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "owner": "whatsproy",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#128c7e"
    },
    "ios": {
      "supportsTablet": true,
      "newArchEnabled": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "googleServicesFile": "./assets/GoogleService-Info.plist",
      "bundleIdentifier": "com.whatsproy"
    },
    "android": {
      "versionCode": 10607,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#128c7e"
      },
      "googleServicesFile": "./assets/google-services.json",
      "newArchEnabled": true,
      "permissions": [
        "NOTIFICATIONS"
      ],
      "package": "com.whatsproy",
      "notification": {
        "icon": "./assets/images/imageIcon.png",
        "color": "#128c7e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#128c7e",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#128c7e"
          },
          "imageWidth": 200
        }
      ],
      "react-native-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceder a la camara para subir archivos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e40e15d9-921b-4314-a35c-1b33afd386da"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e40e15d9-921b-4314-a35c-1b33afd386da"
    }
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "aab",
        "flavor": "play"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "internal": {
      "version": {
        "source": "local"
      }
    }
  }
}
