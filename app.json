{
  "expo": {
    "name": "Measy",
    "slug": "Whatsproy",
    "runtimeVersion": "2.0.2",
    "newArchEnabled": true,
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miapp",
    "owner": "whatsproy",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash_screen_rounded.png",
      "resizeMode": "contain",
      "backgroundColor": "#128c7e"
    },
    "ios": {
      "supportsTablet": true,
      "newArchEnabled": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "googleServicesFile": "./assets/GoogleService-Info.plist",
      "bundleIdentifier": "com.whatsproy",
      "infoPlist": {
        "NSContactsUsageDescription": "Esta aplicación necesita acceder a tus contactos para importarlos."
      }
    },
    "android": {
      "versionCode": 20002,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon_foreground.png",
        "backgroundImage": "./assets/images/icon_background.png"
      },
      "googleServicesFile": "./assets/google-services.json",
      "newArchEnabled": true,
      "permissions": [
        "NOTIFICATIONS",
        "CONTACTS"
      ],
      "package": "com.whatsproy",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "miapp",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#128c7e",
          "image": "./assets/images/splash_screen_rounded.png",
          "dark": {
            "image": "./assets/images/splash_screen_rounded.png",
            "backgroundColor": "#128c7e"
          },
          "imageWidth": 200
        }
      ],
      "react-native-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceder a la camara para subir archivos."
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "deepLinking": true,
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e40e15d9-921b-4314-a35c-1b33afd386da"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e40e15d9-921b-4314-a35c-1b33afd386da"
    }
  }
}
